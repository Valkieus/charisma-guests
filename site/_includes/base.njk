<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }} — Church Guests</title>
  <link rel="stylesheet" href="/style.css">
  <script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
</head>
<body>
  <header class="site-header">
    <div class="wrap-header">
      <a class="brand" href="/"><span class="dot"></span> Church Guests</a>
      <a class="admin-link" href="/admin/">Gérer →</a>
    </div>
  </header>
  <main class="{{ 'wrap' if not fullBleed }}">
    {{ content | safe }}
  </main>

  <div class="doc-modal" id="doc-modal" hidden>
    <div class="doc-modal__backdrop" data-close></div>
    <div class="doc-modal__panel">
      <div class="doc-modal__bar">
        <span id="doc-modal-title"></span>
        <span class="doc-modal__actions">
          <a id="doc-modal-download" href="#" target="_blank" rel="noopener">Télécharger ⭳</a>
          <button type="button" data-close aria-label="Fermer">✕</button>
        </span>
      </div>
      <div class="doc-modal__body">
        <iframe id="doc-modal-frame" title="Aperçu du document"></iframe>
        <pre id="doc-modal-text" hidden></pre>
      </div>
    </div>
  </div>

  <script>
  (function () {
    var modal = document.getElementById('doc-modal');
    var frame = document.getElementById('doc-modal-frame');
    var text = document.getElementById('doc-modal-text');
    var titleEl = document.getElementById('doc-modal-title');
    var dl = document.getElementById('doc-modal-download');

    function youTubeEmbed(url) {
      var m = url.match(/(?:youtu\.be\/|youtube\.com\/watch\?v=)([\w-]+)/);
      return m ? 'https://www.youtube.com/embed/' + m[1] : null;
    }

    function open(url, label) {
      var abs = new URL(url, window.location.href).href;
      titleEl.textContent = label || '';
      dl.href = abs;
      frame.hidden = true;
      text.hidden = true;
      frame.src = 'about:blank';

      var yt = youTubeEmbed(url);
      var ext = (url.split('.').pop() || '').toLowerCase().split('?')[0];

      if (yt) {
        frame.src = yt;
        frame.hidden = false;
      } else if (ext === 'pdf' || ['png','jpg','jpeg','gif','webp','svg'].indexOf(ext) !== -1) {
        frame.src = abs;
        frame.hidden = false;
      } else if (['ppt','pptx','doc','docx','xls','xlsx'].indexOf(ext) !== -1) {
        frame.src = 'https://view.officeapps.live.com/op/embed.aspx?src=' + encodeURIComponent(abs);
        frame.hidden = false;
      } else if (['md','txt'].indexOf(ext) !== -1) {
        text.hidden = false;
        text.textContent = 'Chargement…';
        fetch(abs).then(function (r) { return r.text(); }).then(function (t) {
          text.textContent = t;
        }).catch(function () { text.textContent = "Impossible de charger l'aperçu."; });
      } else {
        text.hidden = false;
        text.textContent = "Aperçu non disponible pour ce type de fichier — utilisez le téléchargement.";
      }

      modal.hidden = false;
      document.body.style.overflow = 'hidden';
    }

    function close() {
      modal.hidden = true;
      frame.src = 'about:blank';
      document.body.style.overflow = '';
    }

    document.addEventListener('click', function (e) {
      var trigger = e.target.closest('[data-preview]');
      if (trigger) {
        e.preventDefault();
        open(trigger.getAttribute('data-preview'), trigger.getAttribute('data-preview-label') || trigger.textContent);
        return;
      }
      if (e.target.closest('[data-close]')) close();
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && !modal.hidden) close();
    });
  })();
  </script>

  <script>
    if (window.netlifyIdentity) {
      window.netlifyIdentity.on("init", function (user) {
        if (!user) {
          window.netlifyIdentity.on("login", function () {
            document.location.href = "/admin/";
          });
        }
      });
    }
  </script>
</body>
</html>
